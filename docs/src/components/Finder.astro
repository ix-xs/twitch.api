---
// "Find your endpoint": every method and every event type of the library,
// filtered as you type. The list is generated from the source code
// (scripts/reference.mjs) and rendered on the server, so it is complete and
// searchable by browsers and search engines alike. Without scripts it shows
// its starting selection and the link to the groups.
import { href, useT, type UiKey } from "../i18n";
import data from "../data/api-index.json";

const { locale } = Astro.locals.starlightRoute;
const t = useT(locale);

/** What the list shows before anything is typed: the calls people come for first. */
const FEATURED = [
  "twitch.users.getByLogin()",
  "twitch.streams.get()",
  "twitch.chat.send()",
  "twitch.moderation.ban()",
  "twitch.channels.followers()",
  "twitch.clips.create()",
  "channel.chat.message",
  "stream.online",
];
const featured = new Set(FEATURED);
// Featured entries first, in the order above, so the script only toggles visibility.
const entries = [
  ...FEATURED.map((name) => data.entries.find((entry) => entry.name === name)).filter((entry) => entry !== undefined),
  ...data.entries.filter((entry) => !featured.has(entry.name)),
];
/** Splits a sentence on its backticks: odd pieces are code. */
const pieces = (text: string): string[] => text.split("`");
const badge = (entry: (typeof entries)[number]): string =>
  entry.kind === "event" ? t("finder.event") : t(`finder.token.${entry.token}` as UiKey);
---

<div class="tw-finder" data-finder data-none={t("finder.none")} data-more={t("finder.more")}>
  <div class="tw-find-box">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
    <label class="sr-only" for="tw-find">{t("finder.label")}</label>
    <input
      id="tw-find"
      type="search"
      placeholder={t("finder.placeholder")}
      autocomplete="off"
      autocapitalize="none"
      autocorrect="off"
      spellcheck="false"
      enterkeyhint="search"
    />
  </div>
  <ul class="tw-results" data-results>
    {entries.map((entry) => (
      <li hidden={!featured.has(entry.name)} data-search={`${entry.name} ${entry.summary}`.toLowerCase()} data-name={entry.name.toLowerCase()}>
        <a href={href(entry.href, locale)}>
          <code>{entry.name}</code>
          <span class="tw-sum">{pieces(entry.summary).map((piece, index) => (index % 2 === 1 ? <code>{piece}</code> : piece))}</span>
          <small>{badge(entry)}</small>
        </a>
      </li>
    ))}
  </ul>
  <p class="tw-find-foot">
    <span data-status aria-live="polite">{t("finder.count", { methods: String(data.counts.methods), events: String(data.counts.events) })}</span>
    <a href={href("/reference/overview/", locale)}>{t("finder.groups")}</a>
  </p>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-finder]");
  if (root) {
    const input = root.querySelector<HTMLInputElement>("input")!;
    const items = [...root.querySelectorAll<HTMLLIElement>("[data-results] > li")];
    const list = root.querySelector<HTMLElement>("[data-results]")!;
    const status = root.querySelector<HTMLElement>("[data-status]")!;
    const idle = status.textContent ?? "";
    const featured = items.filter((item) => !item.hidden);
    const LIMIT = 8;

    input.addEventListener("input", () => {
      const query = input.value.trim().toLowerCase();
      const words = query.split(/\s+/).filter(Boolean);
      if (words.length === 0) {
        for (const item of items) item.hidden = !featured.includes(item);
        for (const item of featured) list.append(item);
        status.textContent = idle;
        return;
      }
      // A match in the name comes before a match in the description.
      const inName: HTMLLIElement[] = [];
      const inText: HTMLLIElement[] = [];
      for (const item of items) {
        const haystack = item.dataset.search ?? "";
        if (!words.every((word) => haystack.includes(word))) continue;
        (words.every((word) => (item.dataset.name ?? "").includes(word)) ? inName : inText).push(item);
      }
      const matches = [...inName, ...inText];
      const shown = new Set(matches.slice(0, LIMIT));
      for (const item of items) item.hidden = !shown.has(item);
      for (const item of shown) list.append(item);
      const rest = matches.length - shown.size;
      status.textContent =
        matches.length === 0
          ? (root.dataset.none ?? "").replace("{query}", input.value.trim())
          : rest > 0
            ? (root.dataset.more ?? "").replace("{count}", String(rest))
            : "";
    });
  }
</script>
