# Copy to `.env` and fill in, then run the examples with: node --env-file=.env --import tsx examples/quick-start.ts
# NEVER put real credentials in this template file.
TWITCH_CLIENT_ID=your-client-id
TWITCH_CLIENT_SECRET=your-client-secret
# Only for examples/webhook-server.ts
EVENTSUB_SECRET=a-random-string-of-10-to-100-characters
CALLBACK_URL=https://your-public-host/twitch/eventsub
